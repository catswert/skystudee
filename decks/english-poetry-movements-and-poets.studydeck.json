    {
      "id": "traits_metaphysical",
      "front": "Which movement? Wit, paradox, huge shifts in scale, introspective philosophical meditation",
      "back": "Metaphysical"
    },
    {
      "id": "traits_augustan",
      "front": "Which movement? Heroic couplets, satire meant to improve society, mock-epic comedy",
      "back": "Augustan"
    },
    {
      "id": "traits_romantics",
      "front": "Which movement? Everyday language, emotion, nature, imagination, the sublime",
      "back": "Romantics"
    },
    {
      "id": "traits_symbolists",
      "front": "Which movement? Dreams, synesthesia, musical sound, deep symbols, art for art’s sake",
      "back": "Symbolists"
    },
    {
      "id": "traits_modernists",
      "front": "Which movement? Fragmentation like cubism, allusions, new forms, many viewpoints at once",
      "back": "Modernists"
    },
    {
      "id": "traits_harlem",
      "front": "Which movement? African American concerns, blues and jazz repetition, a more inclusive America",
      "back": "Harlem Renaissance"
    },
    {
      "id": "traits_postmodern",
      "front": "Which movement? Parody, irony, unstable narrative, collapsing binaries, surface over depth",
      "back": "Post-Modernists"
    },
    {
      "id": "traits_confessional",
      "front": "Which submovement? Personal “I” speaker, sensitive material, innermost doubts and anxieties",
      "back": "Confessional (Post-Modernist)"
    },
    {
      "id": "term_heroic_couplet",
      "front": "Heroic couplet",
      "back": "Two rhyming lines of iambic pentameter; the Augustan signature form"
    },
    {
      "id": "term_iambic_pentameter",
      "front": "Iambic pentameter",
      "back": "Five iambs per line: ten syllables, each pair unstressed then stressed"
    },
    {
      "id": "term_mock_epic",
      "front": "Mock epic",
      "back": "Treating a mundane subject in grand epic style for comedy (Augustan)"
    },
    {
      "id": "term_assonance",
      "front": "Assonance",
      "back": "Repetition of similar vowel sounds"
    },
    {
      "id": "term_consonance",
      "front": "Consonance",
      "back": "Repetition of consonant sounds"
    },
    {
      "id": "term_synesthesia",
      "front": "Synesthesia",
      "back": "Describing one sense in terms of another; a Symbolist technique"
    },
    {
      "id": "term_art_for_arts_sake",
      "front": "Art for art’s sake",
      "back": "Symbolist idea that art should be beautiful and pleasing, not useful"
    },
    {
      "id": "term_rewritten_prosody",
      "front": "Rewritten prosody",
      "back": "Confessional poets recasting earlier movements’ forms in their own voice"
    },
